# Minimal build context: everything is excluded except what compilation needs.
# (Avoids sending node_modules, dist, art generation caches, and local files to the daemon.)
*
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!client/
!shared/
!server/
!scripts/build-server.mjs
!scripts/build-info.mjs

# Even inside included folders: no local clutter.
**/node_modules
**/.DS_Store
**/*.log
